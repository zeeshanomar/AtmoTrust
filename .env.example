ATMOTRUST_ENV=local_demo
ATMOTRUST_DATABASE_PATH=backend/atmotrust.sqlite3
ATMOTRUST_DATA_DIR=data/prepared/demo_v1
ATMOTRUST_ARTIFACT_DIR=artifacts/demo_v1
ATMOTRUST_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000
ATMOTRUST_LIVE_PROVIDER=open_meteo
ATMOTRUST_LOG_LEVEL=INFO
ATMOTRUST_COOKIE_SECURE=false
ATMOTRUST_EMAIL_ENABLED=false
ATMOTRUST_SMTP_HOST=
ATMOTRUST_SMTP_PORT=587
ATMOTRUST_SMTP_USERNAME=
ATMOTRUST_SMTP_PASSWORD=
ATMOTRUST_SMTP_SENDER=
ATMOTRUST_FRONTEND_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL and VITE_WS_BASE_URL are optional. Same-origin defaults work with local production serving.
